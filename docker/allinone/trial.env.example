# Isolated all-in-one trial only. Unset/off preserves the normal application.
SKATING_TRIAL_PROFILE=web-preview
SKATING_TRIAL_VERSION=20261013-candidate
SKATING_ANALYSIS_PIPELINE=legacy
DATA_DIR=/data
UPLOADS_DIR=/data/uploads
ARCHIVE_DIR=/data/archive
BACKUPS_DIR=/backups
