V2_ANALYSIS_ARTIFACTS_DIR=/data/analysis-assets
V2_GOLDEN_DIR=/data/golden
V2_CACHE_DIR=/data/cache
VIDEO_PROCESSING_ROOT=/data/temp-frames
V2_MODEL_OUTPUTS_DIR=/data/model-outputs
V2_TEST_DATA_DIR=/data/test-data
# No provider keys, no production data, no historical runtime mounts.
