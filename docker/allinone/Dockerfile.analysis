# Exact amd64 Docker Official Images manifests, resolved through their ECR mirror.
FROM public.ecr.aws/docker/library/node@sha256:2c752226d477b4a886378baa95b9af252be59301b725fdb0b7e15208131505a8 AS frontend-build
WORKDIR /build/frontend
RUN node --version && npm --version && cat /etc/os-release
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --fetch-retries=2 --fetch-timeout=60000
COPY frontend/ ./
RUN npm run build

FROM public.ecr.aws/docker/library/python@sha256:8a00ecb83ed9d0864dfd102a1bdb2067fda907ceb30bb86d09da9ee558b19590
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DEFAULT_TIMEOUT=60 PIP_RETRIES=2
RUN python --version && cat /etc/os-release
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 update && apt-get install -y --no-install-recommends nginx curl fonts-wqy-zenhei ffmpeg libglib2.0-0 libgl1 libgomp1 && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-trial-analysis.lock /requirements-trial-analysis.lock
RUN --mount=type=bind,source=wheelhouse,target=/wheels,readonly \
    pip install --no-cache-dir --disable-pip-version-check --no-index --find-links=/wheels --require-hashes -r /requirements-trial-analysis.lock
ARG TRIAL_PROFILE=legacy-analysis-preview
ARG TRIAL_VERSION=r1-unreleased
ENV SKATING_TRIAL_PROFILE=$TRIAL_PROFILE SKATING_TRIAL_VERSION=$TRIAL_VERSION SKATING_ANALYSIS_PIPELINE=legacy \
 DATA_DIR=/data UPLOADS_DIR=/data/uploads ARCHIVE_DIR=/data/archive BACKUPS_DIR=/backups \
 DATABASE_URL=sqlite+aiosqlite:////data/skating-analyzer-v2-trial.db \
 V2_ANALYSIS_ARTIFACTS_DIR=/data/analysis-assets V2_GOLDEN_DIR=/data/golden V2_CACHE_DIR=/data/cache \
 VIDEO_PROCESSING_ROOT=/data/temp-frames V2_MODEL_OUTPUTS_DIR=/data/model-outputs V2_TEST_DATA_DIR=/data/test-data \
 TMPDIR=/data/tmp XDG_CACHE_HOME=/data/cache YOLO_CONFIG_DIR=/data/cache/ultralytics \
 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
 ANNUAL_PDF_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc \
 ANNUAL_PDF_FONT_BOLD_PATH=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
ENV YOLO_PERSON_MODEL_PATH=/models/yolov8n.pt LOCAL_MODEL_MANIFEST=/models/manifest.json \
 POSE_NUM_POSES=1 MEDIAPIPE_POSE_TASK_PATH= YOLO_OFFLINE=true YOLO_AUTOINSTALL=false CUDA_VISIBLE_DEVICES=""
COPY models/ /models/
COPY scripts/build-model-manifest.py /build-model-manifest.py
RUN python /build-model-manifest.py && pip check
WORKDIR /workspace/backend
COPY backend/app /workspace/backend/app
COPY --from=frontend-build /build/frontend/dist /usr/share/nginx/html
COPY docker/allinone/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/allinone/start-trial.sh /start.sh
RUN chmod +x /start.sh && printf legacy-analysis-preview > /etc/skating-trial-profile && rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-available/default
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=3 CMD curl --fail --silent http://127.0.0.1:8000/api/health || exit 1
CMD ["/start.sh"]
