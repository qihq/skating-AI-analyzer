# -- AI 供应商 Key（可选） ---------------------------------------
# 推荐进系统后在「家长设置 -> API 设置」里创建模型实例并保存 Key。
# 如果你更习惯环境变量，也可以在这里填写；Qwen 可填写任意一个，
# 如果你习惯百炼官方示例，优先填 DASHSCOPE_API_KEY。
# QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_VISION_MODEL=qwen3.6-plus
QWEN_VISION_DAILY_COST_LIMIT_CNY=30
QWEN_VISION_VIDEO_ESTIMATED_COST_CNY=0.6
# VIDEO_TEMPORAL_MAX_FRAMES=12
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -- 安全密钥（必填，用于加密存储 API Key） ----------------------
# 建议使用 32 位随机字符串，或 32 位十六进制字符串
SECRET_KEY=replace-with-a-random-32-char-secret

# -- 可选：覆盖默认值 --------------------------------------------
# FRAME_SAMPLE_COUNT=20  # Fallback only when no action profile is selected.
# Profile sampling density and manual-window caps live in backend/app/configs/action_profiles.json.
# MEDIA_RENDITION_KEYFRAME_SECONDS=2  # Keyframe spacing for seek-friendly H.264 renditions.
# PATH_B_MAX_FRAMES=16
# FRAME_THUMB_SIZE=160x90
# FRAME_FULL_SIZE=854x480
# MAX_UPLOAD_SIZE_MB=500
# DATA_DIR=/data
# DATABASE_URL=sqlite+aiosqlite:////data/skating-analyzer.db
# MEDIAPIPE_POSE_TASK_PATH=/models/pose_landmarker_heavy.task
# YOLO_PERSON_MODEL_PATH=/models/yolov8n.pt
# POSE_NUM_POSES=4
# Annual PDF uses a Chinese-capable font mounted or bundled by deployment.
# ANNUAL_PDF_FONT_PATH=/app/assets/fonts/NotoSansCJKsc-Regular.otf
# ANNUAL_PDF_FONT_BOLD_PATH=/app/assets/fonts/NotoSansCJKsc-Bold.otf

# -- å¯é€‰å®žéªŒï¼šä¸»äººç‰© appearance relock -------------------------
# é»˜è®¤å…³é—­ï¼›å»ºè®®å…ˆåœ¨ golden set/debug eval ä¸­ A/B å¯¹æ¯”åŽå†å¼€å¯ã€‚
# PERSON_TRACKER_APPEARANCE_RELOCK=0
# PERSON_TRACKER_APPEARANCE_RELOCK_THRESHOLD=0.55

# Phase 1.4 soft scoring (layered on APPEARANCE_RELOCK=1):
#   OFF (default): hard threshold pre-filter (fail-closed when similarity<THRESHOLD).
#   ON : add similarity as soft term into relock score; reject only when similarity<FLOOR.
#        anchor/signature missing -> bonus=0 (not rejected). Better for two similar-looking skaters.
#   A/B test on golden set first.
# PERSON_TRACKER_APPEARANCE_RELOCK_SOFT=0
# PERSON_TRACKER_APPEARANCE_RELOCK_SOFT_FLOOR=0.30
# PERSON_TRACKER_APPEARANCE_RELOCK_SOFT_WEIGHT=0.20

# -- Phase 1.1: keyframe signal One-Euro smoothing (default OFF) --
# ON: smooth COM-Y / knee / ankle with One-Euro (reuses smoothing.OneEuroFilter)
#     instead of 3-frame moving average; reduces apex false positives from MediaPipe jitter.
# KEYFRAME_ONE_EURO_SMOOTHING=0
# KEYFRAME_ONE_EURO_MIN_CUTOFF=1.0
# KEYFRAME_ONE_EURO_BETA=0.05

# -- Phase 1.5: manual_lock self-heal (default OFF) --
# When manual_lock is ON and target has been lost for >= MIN_LOST_FRAMES consecutive
# frames, allow ONE detector relock attempt (with appearance signature if APPEARANCE_RELOCK=1).
# If the relock fails, fall back to the original manual_lock static hold.
# Conservative: at most one attempt per analysis run.
# PERSON_TRACKER_MANUAL_LOCK_SELF_HEAL=0
# PERSON_TRACKER_MANUAL_LOCK_SELF_HEAL_MIN_LOST_FRAMES=15
