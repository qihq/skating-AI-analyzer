# Copy to .env.v2.local for isolated V2 development. Never point these values at production data.
SKATING_ANALYSIS_PIPELINE=shadow
V2_RUNTIME_ROOT=C:/path/to/skating-analyzer-v2-runtime
DATA_DIR=C:/path/to/skating-analyzer-v2-runtime/data
DATABASE_URL=sqlite+aiosqlite:///C:/path/to/skating-analyzer-v2-runtime/database/skating-analyzer-v2.db
BACKUPS_DIR=C:/path/to/skating-analyzer-v2-runtime/backups
UPLOADS_DIR=C:/path/to/skating-analyzer-v2-runtime/uploads
ARCHIVE_DIR=C:/path/to/skating-analyzer-v2-runtime/data/archive
VIDEO_PROCESSING_ROOT=C:/path/to/skating-analyzer-v2-runtime/temp-frames/processing
V2_UPLOADS_DIR=C:/path/to/skating-analyzer-v2-runtime/uploads
V2_ANALYSIS_ARTIFACTS_DIR=C:/path/to/skating-analyzer-v2-runtime/analysis-assets
V2_GOLDEN_DIR=C:/path/to/skating-analyzer-v2-runtime/golden
V2_CACHE_DIR=C:/path/to/skating-analyzer-v2-runtime/cache
V2_TEMP_FRAMES_DIR=C:/path/to/skating-analyzer-v2-runtime/temp-frames
V2_MODEL_OUTPUTS_DIR=C:/path/to/skating-analyzer-v2-runtime/model-outputs
V2_TEST_DATA_DIR=C:/path/to/skating-analyzer-v2-runtime/test-data
